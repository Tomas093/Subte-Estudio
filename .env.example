# Copiá este archivo a .env y ajustá lo que necesites.

# Corrector: "ollama" (local, gratis) o "gemini" (API de Google)
SUBTE_PROVEEDOR=ollama
SUBTE_MODELO=qwen3:30b
OLLAMA_URL=http://127.0.0.1:11434

# Solo si usás Gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Voz que lee los resúmenes (usa la misma GEMINI_API_KEY). Voces: Kore, Charon, Aoede, Puck, Leda, Zephyr, Orus, Fenrir.
# También se elige desde la app. GEMINI_VOZ_ESTILO cambia el tono con una instrucción en lenguaje natural.
GEMINI_TTS_MODELO=gemini-2.5-flash-preview-tts
GEMINI_VOZ=Kore
# Cuántos párrafos genera a la vez al preparar el audio. Bajalo a 1 si Gemini te pide esperar seguido.
VOZ_PARALELO=3

# Voces gratis (se instalan con: bash scripts/instalar_voces.sh). También se eligen desde la app.
# Microsoft: es-AR-ElenaNeural, es-AR-TomasNeural, es-MX-DaliaNeural, es-MX-JorgeNeural, es-ES-ElviraNeural, es-ES-AlvaroNeural
MS_VOZ=es-AR-ElenaNeural
# Piper: el nombre de un archivo .onnx de la carpeta voces/ (sin la extensión)
PIPER_VOZ=es_AR-daniela-high

# Dictado de respuestas con whisper.cpp (brew install whisper-cpp ffmpeg)
WHISPER_BIN=whisper-cli
WHISPER_MODELO=~/modelos/ggml-large-v3-turbo-q5_0.bin
WHISPER_IDIOMA=es

# Carpeta donde se guarda tu progreso (por defecto progreso/ dentro del repo).
# Si la ponés en iCloud o Dropbox, tu progreso queda en la nube y lo ves desde otra compu.
# SUBTE_DATOS=~/Library/Mobile Documents/com~apple~CloudDocs/subte-progreso

PUERTO=8765
