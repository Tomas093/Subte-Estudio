# Copiá este archivo a .env y ajustá lo que necesites.

# Corrector: "ollama" (local, gratis) o "gemini" (API de Google)
SUBTE_PROVEEDOR=ollama
SUBTE_MODELO=qwen3:30b
OLLAMA_URL=http://127.0.0.1:11434

# Solo si usás Gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Dictado de respuestas con whisper.cpp (brew install whisper-cpp ffmpeg)
WHISPER_BIN=whisper-cli
WHISPER_MODELO=~/modelos/ggml-large-v3-turbo-q5_0.bin
WHISPER_IDIOMA=es

# Carpeta donde se guarda tu progreso (por defecto progreso/ dentro del repo).
# Si la ponés en iCloud o Dropbox, tu progreso queda en la nube y lo ves desde otra compu.
# SUBTE_DATOS=~/Library/Mobile Documents/com~apple~CloudDocs/subte-progreso

PUERTO=8765
